# Copy this file to `.env` and fill in your values.
# `.env` is git-ignored, so your real values never get pushed to GitHub.

# Bot token from https://discord.com/developers/applications → your app → Bot → Reset Token
DISCORD_TOKEN=

# Discord user ID(s) to track, comma-separated.
# (Discord settings → Advanced → Developer Mode, then right-click a user → Copy User ID)
TRACKED_USER_IDS=

# Who can use /stats and /timeline, comma-separated. Defaults to the tracked users.
OWNER_IDS=

# Server ID where slash commands show up instantly. Leave empty to register
# them globally (can take up to an hour to appear).
GUILD_ID=

# Channel for alerts and the daily summary. Leave empty to get them by DM instead.
NOTIFY_CHANNEL_ID=

# Ping (@mention) the owners when a tracked user comes online. Other alerts
# never ping. Tip: set the channel to "Only @mentions" so only this notifies you.
PING_ON_ONLINE=true

# When to post the day's summary (24h HH:MM in TIMEZONE). Leave empty to turn it off.
SUMMARY_TIME=23:59

# Your timezone, e.g. Asia/Kolkata, Europe/London, America/New_York
TIMEZONE=UTC

# Where the tracking database is stored (git-ignored).
DB_PATH=presence.db

# Seconds between database saves (minimum 15). If the bot dies, at most this
# much time is lost. Higher means fewer wake-ups, which saves phone battery.
HEARTBEAT_SECONDS=60
